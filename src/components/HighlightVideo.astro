---
interface Props {
  src: string;
  poster: string;
  segments: [number, number][];
  label: string;
  focus?: boolean;
  class?: string;
}
const { src, poster, segments, label, focus = false, class: cls = '' } = Astro.props;
---

<video
  class:list={['hv', cls, { focus }]}
  src={src}
  poster={poster}
  data-segments={JSON.stringify(segments)}
  aria-label={label}
  muted
  playsinline
  autoplay
  preload="metadata"></video>

<style>
  .hv {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--navy-950);
  }
  /* Tighter crop on the subject for the robot arm footage */
  .hv.focus {
    transform: scale(1.35);
    transform-origin: 46% 42%;
  }
</style>
