---
import Base from '../../layouts/Base.astro';
import HighlightVideo from '../../components/HighlightVideo.astro';
import { projects, type Project, type Img } from '../../data/projects';
import { u } from '../../lib/url';

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: { project: p, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}
const { project: p, next } = Astro.props;

// Number only the blocks that carry a heading
let n = 0;
const blocks = p.blocks.map((b) => ({ ...b, no: 'heading' in b && b.heading ? String(++n).padStart(2, '0') : '' }));

// Shared aspect for a row of images so they line up
const rowAspect = (imgs: Img[]) => {
  const r = imgs.reduce((a, i) => a + i.w / i.h, 0) / imgs.length;
  return r > 1.15 ? '4 / 3' : r < 0.9 ? '3 / 4' : '1 / 1';
};
---

<Base title={`${p.title} — Zaki Dahimene`} description={p.summary} image={p.cover.src}>
  <div class="frame">
    <nav class="row crumbs mono" aria-label="Breadcrumb">
      <a class="cell" href={u('/#work')}>← All Work</a>
      <span class="cell">Project {p.no} / {String(projects.length).padStart(2, '0')}</span>
    </nav>

    <header class="row title-row">
      <div class="cell">
        <p class="mono over">{p.kicker}</p>
        <h1>{p.title}<i>.</i></h1>
      </div>
    </header>

    <dl class="row tblock">
      <div class="cell"><dt class="mono">Role</dt><dd>{p.role}</dd></div>
      <div class="cell"><dt class="mono">Context</dt><dd>{p.context}</dd></div>
      <div class="cell"><dt class="mono">Year</dt><dd>{p.year}</dd></div>
      <div class="cell"><dt class="mono">Tools</dt><dd class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</dd></div>
    </dl>

    <figure class="row cover">
      <img src={p.cover.src} alt={p.cover.alt} width={p.cover.w} height={p.cover.h} fetchpriority="high" />
    </figure>

    <section class="row split">
      <div class="cell mono lbl">Overview</div>
      <div class="cell"><p class="summary">{p.summary}</p></div>
    </section>

    <section class="row pstats" aria-label="Key results">
      {p.stats.map((s) => (
        <div class="cell reveal">
          <b>{s.value}</b>
          <span class="mono">{s.label}</span>
        </div>
      ))}
    </section>

    {p.video && (
      <section class="row vid" aria-label="Video">
        <div class="vid-wrap">
          <HighlightVideo src={p.video.src} poster={p.video.poster} segments={p.video.segments} label={p.video.caption} focus={p.video.focus} />
        </div>
        <p class="mono vid-cap">▶ {p.video.caption}</p>
      </section>
    )}

    {blocks.map((b) => {
      if (b.kind === 'callout') {
        return (
          <section class="row callout reveal">
            <div class="cell mono lbl">!</div>
            <div class="cell"><p>{b.text}</p></div>
          </section>
        );
      }
      if (b.kind === 'text') {
        return (
          <section class="row split reveal">
            <div class="cell lbl">
              <span class="mono num">{b.no}</span>
              <h2>{b.heading}</h2>
            </div>
            <div class="cell prose">{b.body.map((para) => <p>{para}</p>)}</div>
          </section>
        );
      }
      if (b.kind === 'docs') {
        return (
          <section class="row split reveal">
            <div class="cell lbl">
              <span class="mono num">{b.no}</span>
              <h2>{b.heading}</h2>
            </div>
            <div class="cell docs">
              {b.files.map((f) => (
                <a class="doc" href={f.href} target="_blank" rel="noopener">
                  <span class="doc-ic" aria-hidden="true">PDF</span>
                  <span class="doc-t">
                    <b>{f.title}</b>
                    <span>{f.desc}</span>
                  </span>
                  <span class="mono doc-s">{f.size} ↗</span>
                </a>
              ))}
            </div>
          </section>
        );
      }
      const aspect = rowAspect(b.images);
      const count = Math.min(b.images.length, 4);
      return (
        <section class="row split reveal">
          <div class:list={['cell lbl', { nolbl: !b.heading }]}>
            {b.heading && (
              <>
                <span class="mono num">{b.no}</span>
                <h2>{b.heading}</h2>
              </>
            )}
          </div>
          <div class:list={['cell media', { 'has-text': b.text, 'text-first': b.side === 'left', solo: b.images.length === 1 }]}>
            <div class="pics" style={`--cols:${count}; --ar:${aspect}`}>
              {b.images.map((im) => (
                <figure>
                  <a href={im.src} target="_blank" rel="noopener" aria-label={`Open full size: ${im.alt}`}>
                    <img src={im.sm} alt={im.alt} loading="lazy" width={im.w} height={im.h} />
                  </a>
                  {im.caption && <figcaption class="mono">{im.caption}</figcaption>}
                </figure>
              ))}
            </div>
            {b.text && <p class="media-text">{b.text}</p>}
          </div>
        </section>
      );
    })}

    {p.gallery && p.gallery.length > 0 && (
      <section class="gallery" aria-label="Gallery">
        <div class="row">
          <div class="cell mono lbl">Gallery · {p.gallery.length} Images</div>
        </div>
        <div class="row grid" style={`--gcols:${p.gallery.length % 3 === 0 || p.gallery.length % 2 === 1 ? 3 : 2}`}>
          {p.gallery.map((g, i) => (
            <figure class="g reveal">
              <a href={g.src} target="_blank" rel="noopener" aria-label={`Open full size: ${g.alt}`}>
                <img src={g.sm} alt={g.alt} loading="lazy" width={g.w} height={g.h} />
              </a>
              <figcaption class="mono">
                <span>{p.no}.{String(i + 1).padStart(2, '0')}</span> {g.alt}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <a class="row next" href={u(`/projects/${next.slug}`)}>
      <div class="cell">
        <span class="mono">Next Project · {next.no}</span>
        <span class="nt">{next.short} →</span>
      </div>
      <div class="next-img">
        <img src={next.cover.sm} alt="" loading="lazy" />
      </div>
    </a>
  </div>
</Base>

<style>
  .crumbs {
    grid-template-columns: auto 1fr;
    color: var(--ink-mute);
  }
  .crumbs .cell {
    padding-top: 14px;
    padding-bottom: 14px;
  }
  .crumbs a {
    color: var(--ink);
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .crumbs span {
    text-align: right;
  }
  .over {
    margin: 0 0 12px;
    color: var(--accent);
  }
  h1 {
    margin: 0;
    font-size: clamp(36px, 6.4vw, 112px);
    font-weight: 800;
    font-variation-settings: 'wdth' 118;
    letter-spacing: -0.04em;
    line-height: 0.92;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  h1 i {
    font-style: normal;
    color: var(--accent);
  }
  .tblock {
    margin: 0;
    grid-template-columns: 1.1fr 1.4fr 0.6fr 1.6fr;
  }
  .tblock dt {
    color: var(--ink-mute);
    margin-bottom: 6px;
  }
  .tblock dd {
    margin: 0;
    font-weight: 500;
    line-height: 1.4;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cover {
    margin: 0;
    overflow: hidden;
    background: var(--navy-950);
  }
  .cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    max-height: 78vh;
    object-fit: cover;
  }
  .lbl {
    color: var(--ink-mute);
  }
  .split {
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
  }
  .summary {
    margin: 0;
    font-size: clamp(20px, 2vw, 32px);
    line-height: 1.3;
    font-weight: 500;
    max-width: 30em;
  }
  .pstats {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .pstats .cell {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pstats b {
    font-size: clamp(34px, 4.2vw, 72px);
    font-weight: 800;
    font-variation-settings: 'wdth' 118;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .pstats .mono {
    color: var(--ink-mute);
    font-size: 11px;
    max-width: 26ch;
  }
  .vid {
    position: relative;
    background: var(--navy-950);
  }
  .vid-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    max-height: 78vh;
    width: 100%;
  }
  .vid-cap {
    position: absolute;
    left: 14px;
    bottom: 12px;
    margin: 0;
    background: rgba(6, 15, 34, 0.78);
    padding: 6px 10px;
    font-size: 11px;
    color: var(--ink-soft);
  }

  /* Blocks */
  .num {
    color: var(--accent);
  }
  .lbl h2 {
    margin: 6px 0 0;
    font-size: clamp(22px, 2.3vw, 36px);
    font-weight: 700;
    font-variation-settings: 'wdth' 112;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--ink);
  }
  .prose p {
    margin: 0 0 1em;
    max-width: 62ch;
    color: var(--ink-soft);
  }
  .prose p:last-child {
    margin-bottom: 0;
  }

  .media.has-text {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: var(--gutter);
    align-items: center;
  }
  .media.has-text.solo {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  .media.text-first .media-text {
    order: -1;
  }
  .media-text {
    margin: 0;
    font-size: clamp(17px, 1.35vw, 21px);
    line-height: 1.5;
    color: var(--ink);
    max-width: 34ch;
  }
  .pics {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 10px;
  }
  .pics figure {
    margin: 0;
    min-width: 0;
  }
  .pics a {
    display: block;
    overflow: hidden;
    background: var(--navy-950);
    aspect-ratio: var(--ar);
  }
  .pics img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }
  .solo .pics a {
    max-height: 480px;
  }
  .pics a:hover img {
    transform: scale(1.03);
  }
  .pics figcaption {
    margin-top: 8px;
    font-size: 10.5px;
    color: var(--ink-mute);
  }

  .callout {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .callout .lbl {
    color: var(--accent-ink);
    font-size: 28px;
    font-weight: 500;
  }
  .callout .cell + .cell {
    border-left-color: rgba(26, 13, 5, 0.2);
  }
  .callout p {
    margin: 0;
    font-size: clamp(24px, 3vw, 46px);
    font-weight: 800;
    font-variation-settings: 'wdth' 112;
    letter-spacing: -0.025em;
    line-height: 1.1;
    max-width: 24ch;
  }

  .docs {
    display: grid;
    gap: 12px;
  }
  .doc {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    padding: 18px 20px;
    border: 1px solid var(--line-strong);
    transition: border-color 0.2s, background 0.2s;
  }
  .doc:hover {
    border-color: var(--accent);
    background: var(--navy-850);
  }
  .doc-ic {
    display: grid;
    place-items: center;
    width: 48px;
    height: 56px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
  }
  .doc-t {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .doc-t b {
    font-size: 18px;
  }
  .doc-t span {
    color: var(--ink-mute);
    font-size: 15px;
  }
  .doc-s {
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .grid {
    grid-template-columns: repeat(var(--gcols, 3), minmax(0, 1fr));
  }
  .g {
    margin: 0;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .g a {
    display: block;
    overflow: hidden;
    background: var(--navy-950);
    aspect-ratio: 4 / 3;
  }
  .g img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }
  .g a:hover img {
    transform: scale(1.03);
  }
  .g figcaption {
    padding: 10px 14px 12px;
    font-size: 10.5px;
    line-height: 1.5;
    color: var(--ink-mute);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .g figcaption span {
    color: var(--accent);
    margin-right: 6px;
  }

  .next {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: var(--navy-850);
    transition: background 0.3s;
  }
  .next:hover {
    background: var(--navy-800);
  }
  .next .cell {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
  }
  .next .mono {
    color: var(--accent);
  }
  .nt {
    font-size: clamp(30px, 4.2vw, 68px);
    font-weight: 800;
    font-variation-settings: 'wdth' 118;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .next-img {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-left: 1px solid var(--line);
  }
  .next-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.7) brightness(0.85);
    transition: transform 0.8s var(--ease), filter 0.4s;
  }
  .next:hover .next-img img {
    transform: scale(1.04);
    filter: none;
  }

  /* Tablet / small laptop */
  @media (max-width: 1100px) {
    .media.has-text,
    .media.has-text.solo {
      grid-template-columns: minmax(0, 1fr);
    }
    .media.text-first .media-text {
      order: 0;
    }
    .media-text {
      max-width: 60ch;
    }
    .solo .pics {
      max-width: 560px;
    }
  }
  @media (max-width: 900px) {
    .tblock {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .tblock .cell:nth-child(3) {
      border-left: 0;
    }
    .tblock .cell:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .split,
    .next {
      grid-template-columns: minmax(0, 1fr);
    }
    .split .cell + .cell {
      border-left: 0;
      padding-top: 0;
    }
    .split .nolbl {
      display: none;
    }
    .split .nolbl + .cell {
      padding-top: var(--gutter);
    }
    .callout .cell + .cell {
      padding-top: 0;
    }
    .next-img {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Phone */
  @media (max-width: 640px) {
    .pstats {
      grid-template-columns: minmax(0, 1fr);
    }
    .pstats .cell + .cell {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .pics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .solo .pics {
      grid-template-columns: minmax(0, 1fr);
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .g {
      border-right: 0;
    }
    .cover img {
      aspect-ratio: 4 / 3;
    }
    .doc {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .doc-s {
      grid-column: 2;
    }
  }
  /* Short landscape screens (phones on their side, small laptops) */
  @media (max-height: 520px) and (orientation: landscape) {
    .cover img,
    .vid-wrap {
      max-height: 88vh;
    }
  }
</style>
